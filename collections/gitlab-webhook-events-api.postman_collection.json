          "id": "11cb3bb5-932a-422e-8d57-da99e0a82b40",
          "name": "GitLab Test a Webhook Trigger",
          "request": {
            "name": "GitLab Test a Webhook Trigger",
            "description": {
              "content": "Sends a test webhook payload of the specified trigger type to the configured webhook URL. Use this to verify the webhook endpoint is reachable and handling payloads correctly.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":id",
                "hooks",
                ":hook_id",
                "test",
                ":trigger"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
