        {
          "id": "8eab9b8e-9207-49e9-9491-6e5313e9b2cb",
          "name": "GitLab Initiate Device Authorization Grant",
          "request": {
            "name": "GitLab Initiate Device Authorization Grant",
            "description": {
              "content": "Initiates the OAuth 2.0 device authorization grant flow for input-constrained devices. Returns a device code and user code that the user enters on a secondary device to authorize access.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "authorize_device"
              ],
              "host": [
                "{{baseUrl}}"
