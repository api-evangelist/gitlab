      "item": [
        {
          "id": "e98898d2-506c-4ec1-8ce3-be7819f9da10",
          "name": "GitLab Authorize OAuth Application",
          "request": {
            "name": "GitLab Authorize OAuth Application",
            "description": {
              "content": "Initiates the OAuth 2.0 authorization code flow. Redirects the user to the GitLab authorization page where they can grant access to the application. Supports PKCE for public clients by including the code_challenge and code_challenge_method parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The application ID registered in GitLab."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) The URI to redirect to after authorization."
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to code for the authorization code flow."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "(Required) A random, unguessable string used to protect against CSRF attacks. Must be returned unchanged in the redirect response."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Space-separated list of scopes to request. Available scopes include api, read_api, read_user, read_repository, write_repository, and others."
                },
                {
                  "disabled": false,
                  "key": "code_challenge",
                  "value": "<string>",
                  "description": "A Base64 URL-encoded SHA-256 hash of the code_verifier. Required when using PKCE for public clients."
                },
                {
                  "disabled": false,
                  "key": "code_challenge_method",
                  "value": "<string>",
                  "description": "The method used to generate the code_challenge. Must be S256."
                },
                {
                  "disabled": false,
                  "key": "root_namespace_id",
                  "value": "<integer>",
                  "description": "Optional. Limits group access token creation to a specific namespace."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
