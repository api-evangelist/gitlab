          "name": "GitLab Revoke an OAuth Token",
          "request": {
            "name": "GitLab Revoke an OAuth Token",
            "description": {
              "content": "Revokes an existing OAuth access token or refresh token. After revocation the token can no longer be used to access GitLab resources. Supports CORS for browser-based applications.",
