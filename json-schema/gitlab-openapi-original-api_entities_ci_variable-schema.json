{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/gitlab/refs/heads/main/json-schema/gitlab-openapi-original-api_entities_ci_variable-schema.json",
  "title": "API_Entities_Ci_Variable",
  "description": "API_Entities_Ci_Variable model",
  "type": "object",
  "properties": {
    "variable_type": {
      "type": "string",
      "example": "env_var"
    },
    "key": {
      "type": "string",
      "example": "TEST_VARIABLE_1"
    },
    "value": {
      "type": "string",
      "example": "TEST_1"
    },
    "protected": {
      "type": "boolean",
      "example": true
    },
    "masked": {
      "type": "boolean",
      "example": true
    },
    "raw": {
      "type": "boolean",
      "example": true
    },
    "environment_scope": {
      "type": "string",
      "example": "*"
    }
  }
}